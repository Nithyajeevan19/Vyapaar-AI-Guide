# Vyapaar AI — Local development environment template
# Copy this file to .env and fill in the values.

# To enable Gemini AI branding generation, add your key below:
VITE_GEMINI_API_KEY=

# OpenAI is no longer required — the voice agent uses a scripted conversation
VITE_OPENAI_API_KEY=

# Firebase Configuration (Required for authentication and database services)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
