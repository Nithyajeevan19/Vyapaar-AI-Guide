# Vyapaar AI — Backend Express server environment template
# Copy this file to .env inside artifacts/api-server/ and fill in the values.

# Server configurations
PORT=5000
NODE_ENV=development

# Security Fallbacks:
# If you are developing locally without an active Firebase Auth sync header (x-user-id),
# you can opt-in to fallback to a mock user context (mock-user-1) by setting this to true.
# Set this to false or leave empty in staging/production to block unauthorized access.
ALLOW_DEV_AUTH_FALLBACK=false

# Database Configuration (Optional: fallback uses local mock_database.json proxy)
DATABASE_URL=

# Gemini Generative AI API configuration (For branding & analytics strategic insights)
GEMINI_API_KEY=

# OpenAI completions API configuration (For copilot completion queries proxy)
OPENAI_API_KEY=
